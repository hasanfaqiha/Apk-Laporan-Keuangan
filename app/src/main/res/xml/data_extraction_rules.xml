<?xml version="1.0" encoding="utf-8"?><!--
   KeuanganKu data extraction rules (Android 12+).
   The local Room database and preferences stay out of Google cloud backup:
   finance data only leaves the device through the user's own Firebase sync.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="finance_database" />
        <exclude domain="sharedpref" path="finance_prefs.xml" />
    </cloud-backup>
    <!--
    <device-transfer>
        <include .../>
        <exclude .../>
    </device-transfer>
    -->
</data-extraction-rules>
