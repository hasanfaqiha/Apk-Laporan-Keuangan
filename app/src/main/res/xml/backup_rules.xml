<?xml version="1.0" encoding="utf-8"?><!--
   KeuanganKu backup rules (devices older than API 31).
   Financial data is sensitive: it is synced through Firebase when the user opts
   into an account, so we deliberately keep the local Room database and
   preferences OUT of Google's automatic cloud backup.
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <exclude domain="database" path="finance_database" />
    <exclude domain="sharedpref" path="finance_prefs.xml" />
</full-backup-content>
